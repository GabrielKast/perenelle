{
  "name": "perenelle-workspace",
  "private": true,
  "type": "module",
  "//": [
    "Build setup A1: cross-package imports resolve to each package's compiled dist/,",
    "so `start` and `test` always run `tsc -b` first. See docs/build.md.",
    "A2 (switch only if the build step becomes slow): run from sources with",
    "  \"start\": \"node --conditions=source packages/cli/src/main.ts\",",
    "  \"test\": \"node --conditions=source --test \\\"packages/*/src/**/*.test.ts\\\"\""
  ],
  "workspaces": [
    "packages/core",
    "packages/settings",
    "packages/docker",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "tsc -b && node packages/cli/dist/main.js",
    "test": "tsc -b && node --test \"packages/*/src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
